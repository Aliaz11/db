# ---------------------------------------------------------------------------
# Line endings
#
# Let git decide what is text, and normalise text files to LF inside the
# repository. This is a Windows-only WinForms project, so everything that a
# human or the Visual Studio designer edits is checked out with CRLF.
#
# NOTE: the blobs currently in history were committed with CRLF (they were
# added before this file existed). The first commit made after adding
# .gitattributes will therefore renormalise them. Do that deliberately, on its
# own, with:
#
#     git add --renormalize .
#     git commit -m "Normalise line endings"
#
# ...otherwise every source file shows up as fully rewritten in an unrelated
# commit.
# ---------------------------------------------------------------------------
* text=auto

# Source and project files -- CRLF in the working tree (Visual Studio writes
# CRLF and the WinForms designer rewrites whole files if it disagrees).
*.cs        text eol=crlf diff=csharp
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.config    text eol=crlf
*.settings  text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf

# .resx is XML: keep it text so diffs are reviewable, but it is generated by
# the designer, so mark it as such to keep it out of language statistics and
# out of most code reviews.
*.resx      text eol=crlf linguist-generated=true

# Repo metadata / docs
*.md        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf
LICENSE     text eol=lf

# Shell / batch
*.sh        text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# ---------------------------------------------------------------------------
# Binaries -- never touched by eol conversion, never diffed as text
# ---------------------------------------------------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.bmp       binary
*.ico       binary
*.pdf       binary

# LocalDB data files. These are gitignored (see .gitignore) and should never
# come back; the marker is here so that an accidental `git add -f` at least
# does not corrupt them with line-ending conversion.
*.mdf       binary
*.ldf       binary
*.ndf       binary
*.bak       binary

*.dll       binary
*.exe       binary
*.pdb       binary
*.snk       binary
