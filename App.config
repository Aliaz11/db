<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!-- No secrets belong in this file. The SMTP password is read from the SMTP_PASSWORD
       environment variable only; every key below can also be overridden by the environment
       variable named in db.Configuration.AppSettings. -->
  <connectionStrings>
    <add name="Default"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|Stu2.mdf;Integrated Security=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Smtp.Host" value="smtp.gmail.com" />
    <add key="Smtp.Port" value="587" />
    <add key="Smtp.UseStartTls" value="true" />
    <!-- Set locally; leave empty in source control. -->
    <add key="Smtp.UserName" value="" />
    <add key="Smtp.From" value="" />
  </appSettings>
</configuration>
